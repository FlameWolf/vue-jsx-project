{
	"name": "vue-jsx-project",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node ./scripts/run-all dev",
		"build": "npm run type-check && npm run build-only",
		"preview": "node ./scripts/run-all preview",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"format": "prettier --write --experimental-cli src/"
	},
	"dependencies": {
		"@fullhuman/postcss-purgecss": "^8.0.0",
		"bootstrap": "^5.3.8",
		"idb": "^8.0.3",
		"vue": "rc",
		"vue-jsx-vapor": "^3.2.21",
		"vue-router": "^5.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vitejs/plugin-vue-jsx": "^5.1.6",
		"@vue/tsconfig": "^0.9.1",
		"typescript": "~6.0.0",
		"vite": "^8.1.5",
		"vue-tsc": "^3.3.7"
	},
	"overrides": {
		"vue": "rc",
		"@vue/compiler-core": "rc",
		"@vue/compiler-dom": "rc",
		"@vue/compiler-sfc": "rc",
		"@vue/compiler-ssr": "rc",
		"@vue/compiler-vapor": "rc",
		"@vue/reactivity": "rc",
		"@vue/runtime-core": "rc",
		"@vue/runtime-dom": "rc",
		"@vue/runtime-vapor": "rc",
		"@vue/server-renderer": "rc",
		"@vue/shared": "rc",
		"@vue/compat": "rc"
	}
}